---
import { siteConfig } from '../config';
---

<footer class="mt-auto border-t border-white/10 bg-[#060708] py-12 px-4 relative z-20">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
    
    <!-- Left: Brand & Community -->
    <div>
      <div class="flex items-center justify-center md:justify-start gap-2.5 mb-2">
        <span class="w-3 h-3 rounded-full bg-[#53FC18] shadow-[0_0_8px_#53FC18]"></span>
        <span class="font-extrabold text-white text-lg tracking-tight">
          {siteConfig.streamerName}
        </span>
        <span class="text-xs bg-[#53FC18] text-black font-black px-1.5 py-0.5 rounded">
          KICK STREAMER
        </span>
      </div>
      <p class="text-xs text-white/50 max-w-sm leading-relaxed">
        Página oficial del conteo regresivo. El canal oficial de Kick reabre sus puertas en 5 días.
      </p>
    </div>

    <!-- Center: Socials & Easter egg rave mode -->
    <div class="flex flex-col items-center gap-3">
      <div class="flex flex-wrap items-center justify-center gap-2">
        <span class="text-[11px] font-mono text-white/40">Redes aún activas:</span>
        <a href="https://www.tiktok.com/@nicolebereniceu" target="_blank" rel="noopener noreferrer" class="text-xs text-white/60 hover:text-[#25F4EE] transition-colors" title="TikTok @nicolebereniceu">TikTok</a>
        <span class="text-white/20">•</span>
        <a href="https://www.tiktok.com/@spicyberenice" target="_blank" rel="noopener noreferrer" class="text-xs text-white/60 hover:text-[#FE2C55] transition-colors" title="TikTok @spicyberenice">Spicy</a>
        <span class="text-white/20">•</span>
        <a href="https://www.instagram.com/nicoleberenice_" target="_blank" rel="noopener noreferrer" class="text-xs text-white/60 hover:text-[#E1306C] transition-colors" title="Instagram @nicoleberenice_">Instagram</a>
        <span class="text-white/20">•</span>
        <a href="https://www.twitch.tv/berenicenicole" target="_blank" rel="noopener noreferrer" class="text-xs text-white/60 hover:text-[#9146FF] transition-colors" title="Twitch berenicenicole">Twitch</a>
      </div>

      <button 
        id="raveEasterEggBtn" 
        class="px-4 py-2 rounded-xl bg-white/[0.04] hover:bg-[#53FC18]/15 border border-white/10 hover:border-[#53FC18]/40 text-xs font-mono font-bold text-white/80 hover:text-[#53FC18] transition-all cursor-pointer active:scale-95"
      >
        <span>✨ Activar Modo Fiesta Kick ✨</span>
      </button>
      <span class="text-[10px] text-white/30 font-mono">Easter egg para el chat</span>
    </div>

    <!-- Right: Direct Kick link & Quick Return -->
    <div class="flex flex-col sm:flex-row items-center gap-4">
      <a 
        href={siteConfig.kickUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="px-4 py-2 rounded-xl bg-[#53FC18]/20 border border-[#53FC18]/40 text-[#53FC18] hover:bg-[#53FC18] hover:text-black font-bold text-xs tracking-wide transition-all"
      >
        kick.com/{siteConfig.kickUsername} ↗
      </a>

      <a 
        href="#" 
        class="text-xs text-white/40 hover:text-white transition-colors"
        title="Volver arriba"
      >
        ↑ Subir
      </a>
    </div>

  </div>

  <div class="max-w-6xl mx-auto mt-8 pt-6 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between text-[11px] text-white/40 gap-2">
    <span>Hecho con Astro • Especial para {siteConfig.streamerName}</span>
    <span class="font-mono text-[#53FC18]/70">#NicoleEnKick #StreamCountdown</span>
  </div>
</footer>

<script>
  import confetti from 'canvas-confetti';
  import { playLevelUpSound } from '../utils/sound';

  const raveBtn = document.getElementById('raveEasterEggBtn');

  raveBtn?.addEventListener('click', () => {
    playLevelUpSound();

    // Massive confetti barrage
    const duration = 2.5 * 1000;
    const animationEnd = Date.now() + duration;

    const interval: number = window.setInterval(() => {
      const timeLeft = animationEnd - Date.now();
      if (timeLeft <= 0) {
        return clearInterval(interval);
      }
      confetti({
        particleCount: 50,
        startVelocity: 30,
        spread: 360,
        origin: { x: Math.random(), y: Math.random() - 0.2 },
        colors: ['#53FC18', '#00E599', '#FFFFFF', '#FFDF00', '#A855F7']
      });
    }, 250);

    // Subtle background flash
    document.body.classList.add('transition-colors', 'duration-500');
    document.body.style.backgroundColor = '#0b160b';
    setTimeout(() => {
      document.body.style.backgroundColor = '#08090A';
    }, 1500);
  });
</script>

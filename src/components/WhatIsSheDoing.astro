---
import { siteConfig } from '../config';
---

<section class="py-12 max-w-4xl mx-auto px-4 w-full">
  <div class="glass-panel border border-white/10 rounded-3xl p-6 sm:p-10 relative overflow-hidden">
    
    <!-- Radar Scanline Effect -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#53FC18]/5 to-transparent pointer-events-none opacity-40 animate-pulse"></div>

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-white/5">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#53FC18]/10 text-[#53FC18] text-xs font-mono font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-[#53FC18] animate-ping"></span>
          RADAR EN VIVO: DETECCIÓN DE ACTIVIDAD
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          ¿Qué está haciendo Nicole ahora mismo?
        </h2>
      </div>

      <!-- Action Button -->
      <button 
        id="scanActivityBtn"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/[0.06] hover:bg-[#53FC18]/20 border border-white/10 hover:border-[#53FC18]/50 text-white hover:text-[#53FC18] text-xs sm:text-sm font-bold transition-all active:scale-95 cursor-pointer whitespace-nowrap"
      >
        <span>🔄</span>
        <span>Escanear otra vez</span>
      </button>
    </div>

    <!-- Terminal Monitor Box -->
    <div class="bg-[#050607] border border-[#53FC18]/20 rounded-2xl p-6 sm:p-8 relative overflow-hidden font-mono text-sm shadow-inner">
      <!-- Status Bar Top -->
      <div class="flex items-center justify-between text-xs text-white/40 mb-4 pb-3 border-b border-white/5">
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#53FC18]"></span>
          SATÉLITE DE KICK: CONECTADO
        </span>
        <span id="scanTimestamp" class="font-mono text-[#53FC18]">SEÑAL ESTABLE</span>
      </div>

      <!-- Output Screen -->
      <div class="min-h-[70px] flex items-center">
        <p id="activityText" class="text-base sm:text-xl font-bold text-white leading-relaxed font-sans transition-all duration-300">
          "{siteConfig.randomActivities[0]}"
        </p>
      </div>

      <!-- Subtle Footer inside terminal -->
      <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between text-[11px] text-white/30">
        <span>Confidencial • Solo para el fandom</span>
        <span class="text-[#53FC18]/70">100% Precisión simulada</span>
      </div>
    </div>

  </div>
</section>

<script define:vars={{ activities: siteConfig.randomActivities }}>
  const btn = document.getElementById('scanActivityBtn');
  const textEl = document.getElementById('activityText');
  const timestampEl = document.getElementById('scanTimestamp');

  let currentIndex = 0;

  btn?.addEventListener('click', () => {
    if (!textEl) return;

    // Scan glitch effect
    textEl.style.opacity = '0.3';
    textEl.textContent = "Sintonizando micrófono y cámaras...";
    if (timestampEl) timestampEl.textContent = "ESCANEANDO...";

    setTimeout(() => {
      let nextIndex;
      do {
        nextIndex = Math.floor(Math.random() * activities.length);
      } while (nextIndex === currentIndex && activities.length > 1);

      currentIndex = nextIndex;
      textEl.textContent = `"${activities[currentIndex]}"`;
      textEl.style.opacity = '1';

      if (timestampEl) {
        const now = new Date();
        timestampEl.textContent = `ACTUALIZADO ${now.toLocaleTimeString()}`;
      }
    }, 350);
  });
</script>

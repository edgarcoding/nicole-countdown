---
---

<section class="py-10 max-w-4xl mx-auto px-4 w-full">
  <div class="glass-panel neon-border rounded-3xl p-6 sm:p-10 relative overflow-hidden text-center">
    
    <!-- Decorative background glow -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-64 h-64 bg-[#53FC18]/15 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-xs font-semibold text-white/80 mb-4">
      <span>⚡</span>
      <span>MEDIDOR DE HYPE COMUNITARIO</span>
      <span>⚡</span>
    </div>

    <h2 class="text-2xl sm:text-4xl font-extrabold text-white mb-2 tracking-tight">
      ¿Qué tan ansioso estás por el regreso?
    </h2>
    <p class="text-white/60 text-sm sm:text-base max-w-lg mx-auto mb-8">
      Haz click cuantas veces puedas para llenar la barra de hype de Nicole. ¡El chat ya está spameando verde!
    </p>

    <!-- Hype Progress Bar -->
    <div class="max-w-xl mx-auto mb-8 text-left">
      <div class="flex items-center justify-between text-xs sm:text-sm font-bold mb-2">
        <span class="text-white/80 flex items-center gap-1.5">
          <span class="text-[#53FC18]">●</span>
          <span id="hype-tier-text">Nivel: ¡Chat Calentando Motores! 🔥</span>
        </span>
        <span id="hype-percentage-text" class="text-[#53FC18] font-mono">82%</span>
      </div>

      <!-- Outer Bar -->
      <div class="w-full h-4 sm:h-5 bg-black/60 rounded-full p-1 border border-white/10 overflow-hidden relative shadow-inner">
        <!-- Inner Progress -->
        <div 
          id="hype-progress-bar" 
          class="h-full bg-gradient-to-r from-[#00E599] via-[#53FC18] to-[#99FF55] rounded-full transition-all duration-300 shadow-[0_0_15px_#53FC18]"
          style="width: 82%;"
        >
          <!-- Shimmer line on the bar -->
          <div class="w-full h-full opacity-40 bg-[linear-gradient(90deg,transparent_0%,rgba(255,255,255,0.8)_50%,transparent_100%)] animate-pulse"></div>
        </div>
      </div>

      <!-- Stats under bar -->
      <div class="flex items-center justify-between text-xs text-white/40 mt-2 font-mono">
        <span>Clicks totales: <strong id="total-clicks" class="text-white">1,842</strong></span>
        <span>Meta: Romper el stream 🚀</span>
      </div>
    </div>

    <!-- The Big Hype Button -->
    <div class="relative inline-block">
      <button 
        id="hypeBtn" 
        class="relative group px-8 sm:px-12 py-5 sm:py-6 rounded-2xl bg-gradient-to-r from-[#53FC18] to-[#3ae600] text-black font-black text-lg sm:text-2xl tracking-wider uppercase shadow-[0_0_35px_rgba(83,252,24,0.4)] hover:shadow-[0_0_55px_rgba(83,252,24,0.7)] hover:scale-105 active:scale-95 transition-all select-none cursor-pointer"
      >
        <span class="relative z-10 flex items-center gap-3">
          <span>💚</span>
          <span>¡DAR HYPE AL STREAM!</span>
          <span>🔥</span>
        </span>
        <!-- Ripple ping effect -->
        <span class="absolute inset-0 rounded-2xl bg-[#53FC18] opacity-30 group-hover:animate-ping pointer-events-none"></span>
      </button>

      <!-- Floating Text Container -->
      <div id="floating-tags-container" class="absolute inset-0 pointer-events-none overflow-visible"></div>
    </div>

    <!-- Combo Indicator -->
    <div id="comboBadge" class="opacity-0 transition-opacity duration-300 mt-4 text-xs font-mono font-bold text-[#53FC18]">
      COMBO X<span id="comboCount">0</span>! ¡CHAT ACTIVADÍSIMO! ⚡
    </div>

  </div>
</section>

<script>
  import confetti from 'canvas-confetti';
  import { playHypePop, playLevelUpSound } from '../utils/sound';

  let clicks = 1842;
  let combo = 0;
  let comboResetTimeout: number | undefined;
  let percentage = 82;

  const hypeBtn = document.getElementById('hypeBtn');
  const progressBar = document.getElementById('hype-progress-bar');
  const percentText = document.getElementById('hype-percentage-text');
  const tierText = document.getElementById('hype-tier-text');
  const totalClicksEl = document.getElementById('total-clicks');
  const comboBadge = document.getElementById('comboBadge');
  const comboCountEl = document.getElementById('comboCount');
  const floatingContainer = document.getElementById('floating-tags-container');

  const floatPhrases = [
    "+1 HYPE! 💚",
    "¡VAMOOOS! 🔥",
    "POG CHAT 🐸",
    "REINAAA 👑",
    "W STREAMER ✨",
    "CHAT VERDE 🟢",
    "KICK IS READY ⚡",
    "¡ALERTA MÁXIMA! 🚨",
    "+100 HYPE 🌟"
  ];

  function getTier(pct: number) {
    if (pct < 85) return "Nivel: ¡Chat Calentando Motores! 🔥";
    if (pct < 90) return "Nivel: ¡Hype por las nubes! 🚀";
    if (pct < 98) return "Nivel: ¡MODO BESTIA KICK ACTIVADO! ⚡";
    return "Nivel: ¡SOBRECARGA ABSOLUTA! 👑🎉";
  }

  function spawnFloatingTag(x: number, y: number) {
    if (!floatingContainer) return;
    const tag = document.createElement('div');
    const phrase = floatPhrases[Math.floor(Math.random() * floatPhrases.length)];
    
    tag.textContent = phrase;
    tag.style.position = 'absolute';
    tag.style.left = `${x}px`;
    tag.style.top = `${y}px`;
    tag.style.color = '#53FC18';
    tag.style.fontWeight = '900';
    tag.style.fontSize = '14px';
    tag.style.textShadow = '0 0 10px rgba(83,252,24,0.8), 0 2px 4px rgba(0,0,0,0.8)';
    tag.style.pointerEvents = 'none';
    tag.style.whiteSpace = 'nowrap';
    tag.style.zIndex = '50';
    tag.style.transition = 'all 0.8s cubic-bezier(0.16, 1, 0.3, 1)';
    tag.style.transform = `translate(-50%, -50%) scale(0.8)`;
    tag.style.opacity = '1';

    floatingContainer.appendChild(tag);

    requestAnimationFrame(() => {
      tag.style.transform = `translate(-50%, -80px) scale(1.1)`;
      tag.style.opacity = '0';
    });

    setTimeout(() => {
      tag.remove();
    }, 850);
  }

  hypeBtn?.addEventListener('click', (e) => {
    clicks++;
    combo++;

    // Calculate percentage increase (slows as it approaches 100%)
    if (percentage < 99.8) {
      percentage = Math.min(100, +(percentage + 0.3).toFixed(1));
    }

    if (totalClicksEl) totalClicksEl.textContent = clicks.toLocaleString();
    if (progressBar) progressBar.style.width = `${percentage}%`;
    if (percentText) percentText.textContent = `${percentage}%`;
    if (tierText) tierText.textContent = getTier(percentage);

    // Audio sound
    playHypePop(1 + Math.min(combo * 0.05, 1));

    // Floating text tag
    const rect = hypeBtn.getBoundingClientRect();
    const relX = e.clientX - rect.left;
    const relY = e.clientY - rect.top;
    spawnFloatingTag(relX, relY);

    // Confetti burst
    confetti({
      particleCount: Math.min(25, 10 + combo * 2),
      spread: 60,
      origin: {
        x: (rect.left + rect.width / 2) / window.innerWidth,
        y: (rect.top + rect.height / 2) / window.innerHeight
      },
      colors: ['#53FC18', '#00E599', '#FFFFFF', '#FFFF00']
    });

    // Combo handling
    if (comboCountEl) comboCountEl.textContent = combo.toString();
    if (comboBadge) comboBadge.style.opacity = combo > 2 ? '1' : '0';

    if (combo === 10 || combo === 25 || combo === 50) {
      playLevelUpSound();
      confetti({
        particleCount: 80,
        spread: 100,
        origin: { y: 0.6 },
        colors: ['#53FC18', '#FFFFFF']
      });
    }

    window.clearTimeout(comboResetTimeout);
    comboResetTimeout = window.setTimeout(() => {
      combo = 0;
      if (comboBadge) comboBadge.style.opacity = '0';
    }, 1500);
  });
</script>

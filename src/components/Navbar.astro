---
import { siteConfig } from '../config';
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-[#08090A]/80 border-b border-white/5 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
    
    <!-- Left: Brand / Streamer -->
    <a href="/" class="flex items-center gap-3.5 group">
      <div class="relative">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-[#1c2226] to-[#0d1012] border border-[#53FC18]/30 flex items-center justify-center font-black text-[#53FC18] text-lg shadow-[0_0_15px_rgba(83,252,24,0.25)] group-hover:scale-105 group-hover:border-[#53FC18] transition-all">
          NB
        </div>
        <span class="absolute -bottom-1 -right-1 w-3.5 h-3.5 bg-[#53FC18] rounded-full border-2 border-[#08090A] shadow-[0_0_8px_#53FC18]"></span>
      </div>

      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="font-extrabold text-white text-base tracking-tight group-hover:text-[#53FC18] transition-colors">
            {siteConfig.streamerName}
          </span>
          <!-- Kick Verified Style Badge -->
          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-black bg-[#53FC18] text-black">
            KICK
          </span>
        </div>
        <span class="text-xs text-white/50 font-mono tracking-wider">
          @{siteConfig.kickUsername}
        </span>
      </div>
    </a>

    <!-- Center: Dynamic Streamer Status (Traffic Light: Red -> Amber -> Green) -->
    <div 
      id="statusPill"
      data-target-date={siteConfig.targetDate}
      class="hidden md:flex items-center gap-2.5 px-4 py-1.5 rounded-full backdrop-blur-md transition-all duration-500 cursor-pointer select-none group border border-rose-500/35 bg-rose-950/35 shadow-[0_0_15px_rgba(244,63,94,0.15)] hover:scale-105 active:scale-95"
      title="Haz clic para ver más estados"
    >
      <span class="relative flex h-2.5 w-2.5">
        <span id="statusPing" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-500 opacity-75"></span>
        <span id="statusDot" class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
      </span>
      <span class="text-xs text-white/50 font-medium">Estado:</span>
      <span id="statusText" class="text-xs font-black tracking-wide font-mono text-rose-400 transition-opacity duration-300">
        AÚN BANEADA 🚫
      </span>
      <span class="text-[10px] text-white/30 group-hover:text-white/70 font-mono transition-colors">⟳</span>
    </div>

    <!-- Right: Quick Links & Audio Toggle -->
    <div class="flex items-center gap-3">
      <!-- Sound toggle button -->
      <button 
        id="soundToggleBtn" 
        class="flex items-center justify-center w-10 h-10 rounded-xl bg-white/[0.04] border border-white/10 text-white/70 hover:text-[#53FC18] hover:border-[#53FC18]/40 hover:bg-[#53FC18]/5 transition-all text-sm cursor-pointer"
        title="Activar/Desactivar efectos de sonido"
        aria-label="Alternar sonido"
      >
        <span id="soundIcon">🔊</span>
      </button>

      <!-- Channel Direct Link -->
      <a 
        href={siteConfig.kickUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-2 rounded-xl bg-[#53FC18] text-black font-extrabold text-xs sm:text-sm tracking-wide shadow-[0_0_20px_rgba(83,252,24,0.35)] hover:shadow-[0_0_30px_rgba(83,252,24,0.6)] hover:scale-105 active:scale-95 transition-all"
      >
        <span>IR A KICK</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>

  </div>
</header>

<script>
  import { toggleSound, playHypePop } from '../utils/sound';

  // Sound toggle button
  const soundBtn = document.getElementById('soundToggleBtn');
  const soundIcon = document.getElementById('soundIcon');
  let muted = false;

  soundBtn?.addEventListener('click', () => {
    const isNowEnabled = toggleSound();
    muted = !isNowEnabled;
    if (soundIcon) {
      soundIcon.textContent = muted ? '🔇' : '🔊';
    }
  });

  // Dynamic Status Pill logic (Red -> Amber -> Green)
  const statusPill = document.getElementById('statusPill');
  const statusPing = document.getElementById('statusPing');
  const statusDot = document.getElementById('statusDot');
  const statusText = document.getElementById('statusText');

  const targetDateStr = statusPill?.getAttribute('data-target-date') || '';
  const targetTime = new Date(targetDateStr).getTime();

  let currentIndex = 0;
  let activeMessages: string[] = [];

  function getStatusData(distance: number) {
    const days = Math.max(0, Math.floor(distance / (1000 * 60 * 60 * 24)));
    const hours = Math.max(0, Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)));

    if (distance <= 0) {
      // Phase 3: GREEN (Ya no falta nada, ¡Libre y en vivo!)
      return {
        phase: 'green',
        pillClasses: ['border-[#53FC18]/50', 'bg-[#53FC18]/15', 'shadow-[0_0_20px_rgba(83,252,24,0.3)]'],
        dotClass: 'bg-[#53FC18]',
        pingClass: 'bg-[#53FC18]',
        textClass: 'text-[#53FC18]',
        messages: [
          '¡¡DESBANEADA Y EN VIVO EN KICK!! 🟢',
          '¡¡LIBRE!! PRENDIENDO DIRECTO 🔥',
          'CANAL ACTIVO: ¡ENTRA YA AL CHAT! 👑',
          'SE ACABÓ LA CONDENA: EN VIVO 🟢'
        ]
      };
    } else if (distance <= 24 * 60 * 60 * 1000) {
      // Phase 2: AMBER (Día cercano / Menos de 24 horas restantes)
      return {
        phase: 'amber',
        pillClasses: ['border-amber-400/40', 'bg-amber-950/40', 'shadow-[0_0_18px_rgba(251,191,36,0.2)]'],
        dotClass: 'bg-amber-400',
        pingClass: 'bg-amber-400',
        textClass: 'text-amber-300',
        messages: [
          `DESBAN INMINENTE (FALTAN ${hours}H) ⚠️`,
          'CALENTANDO EL OBS Y EL SETUP 🟡',
          `ÚLTIMAS ${hours} HORAS DE CONDENA ⏳`,
          'APELACIÓN CASI COMPLETADA ⚡',
          'EL CHAT VERDE SE ESTÁ CALENTANDO 👀',
          'PROBANDO MICRÓFONO PARA EL REGRESO 🎙️'
        ]
      };
    } else {
      // Phase 1: RED (Aún baneada / Varios días restantes)
      return {
        phase: 'red',
        pillClasses: ['border-rose-500/35', 'bg-rose-950/35', 'shadow-[0_0_15px_rgba(244,63,94,0.15)]'],
        dotClass: 'bg-rose-500',
        pingClass: 'bg-rose-500',
        textClass: 'text-rose-400',
        messages: [
          `AÚN BANEADA (FALTAN ${days} DÍAS) 🚫`,
          'CUMPLIENDO CONDENA EN KICK 🔒',
          'PELEANDO CON EL TICKET DE SOPORTE 📜',
          'APELACIÓN EN REVISIÓN POR EL STAFF ⚖️',
          'RELEYENDO TÉRMINOS Y CONDICIONES 📝',
          'PRESA EN EL LOBBY DE BANEADOS 🚔',
          `CHAT, FALTAN ${days} DÍAS PARA SALIR 😭`,
          'ESPERANDO EL DESBAN OFICIAL ⏳'
        ]
      };
    }
  }

  function updateStatusDisplay(animate = true) {
    if (!statusPill || !statusDot || !statusPing || !statusText) return;

    const distance = targetTime - Date.now();
    const data = getStatusData(distance);
    activeMessages = data.messages;

    // Remove previous color classes
    statusPill.classList.remove(
      'border-rose-500/35', 'bg-rose-950/35', 'shadow-[0_0_15px_rgba(244,63,94,0.15)]',
      'border-amber-400/40', 'bg-amber-950/40', 'shadow-[0_0_18px_rgba(251,191,36,0.2)]',
      'border-[#53FC18]/50', 'bg-[#53FC18]/15', 'shadow-[0_0_20px_rgba(83,252,24,0.3)]'
    );
    statusDot.classList.remove('bg-rose-500', 'bg-amber-400', 'bg-[#53FC18]');
    statusPing.classList.remove('bg-rose-500', 'bg-amber-400', 'bg-[#53FC18]');
    statusText.classList.remove('text-rose-400', 'text-amber-300', 'text-[#53FC18]');

    // Apply current phase classes
    data.pillClasses.forEach(c => statusPill.classList.add(c));
    statusDot.classList.add(data.dotClass);
    statusPing.classList.add(data.pingClass);
    statusText.classList.add(data.textClass);

    const targetMessage = activeMessages[currentIndex % activeMessages.length];

    if (animate) {
      statusText.style.opacity = '0';
      setTimeout(() => {
        if (statusText) {
          statusText.textContent = targetMessage;
          statusText.style.opacity = '1';
        }
      }, 200);
    } else {
      statusText.textContent = targetMessage;
      statusText.style.opacity = '1';
    }
  }

  // Initialize
  updateStatusDisplay(false);

  // Auto rotate messages every 4.2 seconds
  setInterval(() => {
    currentIndex = (currentIndex + 1) % activeMessages.length;
    updateStatusDisplay(true);
  }, 4200);

  // Click on pill to manually rotate message + play sound
  statusPill?.addEventListener('click', () => {
    playHypePop(1.4);
    currentIndex = (currentIndex + 1) % activeMessages.length;
    updateStatusDisplay(true);
  });
</script>
